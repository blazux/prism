# Prism configuration — copy to .env and edit.
# Quick start: point OLLAMA_URL at your Ollama instance and set the two model
# names. Everything else works out of the box with the bundled docker-compose.

# ══ 1. Chat backend ═══════════════════════════════════════════════════════════
# Which backend answers by default: "ollama" (default), "openai" for any
# OpenAI-compatible server (vLLM, SGLang, TGI, LM Studio, llama.cpp, LiteLLM,
# OpenRouter…), or "anthropic" for Claude.
#
# You can configure several backends at once: the model picker in the UI lists
# every model from every configured backend, and each message is routed to the
# server that holds the model you picked. LLM_BACKEND only sets the default.
# LLM_BACKEND=ollama

# ── Ollama ────────────────────────────────────────────────────────────────────
# host-gateway resolves to the host machine from inside Docker.
OLLAMA_URL=http://host-gateway:11434
# Chat model — must be pulled first (ollama pull <model>).
OLLAMA_MODEL=qwen3.6:27b

# ── OpenAI-compatible server ──────────────────────────────────────────────────
# The /v1 root of the server. Used for chat when LLM_BACKEND=openai, and
# for embeddings when EMBED_BACKEND=openai.
# OPENAI_BASE_URL=http://host-gateway:8000/v1
# Bearer token — optional, local vLLM/SGLang need none.
# OPENAI_API_KEY=
# Default chat model when LLM_BACKEND=openai. Must match the server's
# --served-model-name (the picker also lists whatever /v1/models exposes).
# OPENAI_MODEL=

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Needs an API key from console.anthropic.com — you pay per token. Set the key
# with any LLM_BACKEND and Claude's models join the picker next to your local
# ones; only messages where you explicitly pick a Claude model are billed.
# ANTHROPIC_API_KEY=sk-ant-api03-…
#
# A Claude Pro/Max subscription cannot drive Prism, and the OAuth token the
# `claude` CLI stores (sk-ant-oat…) will not work here: Anthropic refuses tool
# calls made by anything other than Claude Code on it, so the agent loop fails.
# Prism says so at startup rather than failing with an opaque 401. See the README.
#
# Default chat model when LLM_BACKEND=anthropic. With a working key the picker
# lists every model the account can see; this is only the fallback.
# ANTHROPIC_MODEL=claude-sonnet-5
# API root — only for a proxy or gateway; empty = https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# ══ 2. RAG embeddings ═════════════════════════════════════════════════════════
# Embedding model. On Ollama it must be pulled first; on an OpenAI-compatible
# server it must match the served model name.
EMBED_MODEL=qwen3-embedding:8b
# Where embeddings are computed. Empty = follow LLM_BACKEND. Set "ollama" to
# keep RAG on Ollama when chat runs on a server with no /v1/embeddings, or
# "openai" to use the OpenAI-compatible server for embeddings. Anthropic serves
# no embeddings, so with LLM_BACKEND=anthropic RAG stays on Ollama automatically.
# EMBED_BACKEND=

# ══ 3. Vision ═════════════════════════════════════════════════════════════════
# The agent can look at a rendered widget to fix it. Set CHAT_VISION=false if
# the chat model is text-only — the preview is then captioned to text instead.
# VISION_MODEL overrides the model used for that captioning.
# CHAT_VISION=false
# VISION_MODEL=

# ══ 4. Services ═══════════════════════════════════════════════════════════════
# PostgreSQL — the default works with the bundled postgres service.
POSTGRES_URL=postgres://rag:rag@postgres:5432/rag?sslmode=disable
# SearXNG instance for web search (optional — remove to disable web search).
SEARXNG_URL=http://searxng:8080

# Telephony: point VOX_URL at a PrismConnect instance
# (https://github.com/blazux/PrismConnect) and the agent gains a phone — it
# answers calls and can place/list/cancel them as tools. Empty = no telephony.
# VOX_USER/VOX_PASSWORD only if the PrismConnect UI is protected.
# VOX_URL=http://prismconnect:7860
# VOX_USER=
# VOX_PASSWORD=

# ══ 5. Access ═════════════════════════════════════════════════════════════════
# Access token — protects the dashboard with a login screen (optional, remove
# to disable auth).
# PRISM_TOKEN=change-me

# Multi-user mode: "1" turns Prism into a shared deployment — accounts, a
# signup/login page, groups, rooms, per-user scoping and an admin console.
# Unset (default) = personal, single-user, and PRISM_TOKEN is the whole of
# authentication.
# ⚠️ One-way door: turning this on migrates this deployment's config keys and
# secrets into the first admin's scope; single-user mode would no longer find them.
# MULTI_USER=1

# ══ 6. Environment ════════════════════════════════════════════════════════════
# Timezone for the agent and cron jobs (IANA format, e.g. America/New_York, Europe/Paris)
TZ=UTC

# Workspace image variant:
#   unset (default) → ubuntu:22.04 base, ~2GB, no GPU preinstalled
#   gpu             → nvcr.io/nvidia/pytorch base, ~20GB, PyTorch+CUDA preinstalled
#                     for all architectures (Blackwell included)
# WORKSPACE=gpu

# Internal Docker settings — no need to change these
AGENT_CONTAINER=prism-workspace
WORKSPACE_DIR=/workspace
PLUGIN_DIR=/workspace/.plugins

# Host port range for Docker services started by the agent (docker_run tool).
# Each service gets the next available port in this range.
SERVICE_PORT_START=20000
SERVICE_PORT_END=20999
