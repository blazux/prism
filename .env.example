# URL of your Ollama instance — host-gateway resolves to your host machine from inside Docker
OLLAMA_URL=http://host-gateway:11434

# LLM model to use — must be pulled in Ollama first (ollama pull <model>)
OLLAMA_MODEL=qwen3.6:27b

# Embedding model for RAG — must be pulled in Ollama first
EMBED_MODEL=qwen3-embedding:8b

# LLM backend: "ollama" (default), "openai" for any OpenAI-compatible server
# (SGLang, vLLM, TGI, LM Studio, llama.cpp, OpenAI, OpenRouter…), or "anthropic"
# for Claude. By default the "openai" backend serves both chat and embeddings; use
# EMBED_BACKEND below to split them.
# LLM_BACKEND=openai
#
# Base URL pointing at the OpenAI /v1 root (used only when LLM_BACKEND=openai).
# For a local SGLang server: python -m sglang.launch_server --model ... --port 30000
# OPENAI_BASE_URL=http://host-gateway:30000/v1
#
# Bearer token for the openai backend — optional, local SGLang/vLLM need none.
# OPENAI_API_KEY=
#
# Chat model name for the openai backend (overrides OLLAMA_MODEL). Must match the
# server's --served-model-name.
# OPENAI_MODEL=
#
# ── Anthropic / Claude (LLM_BACKEND=anthropic) ────────────────────────────────
#
# Needs an API key from console.anthropic.com — you pay per token.
# ANTHROPIC_API_KEY=sk-ant-api03-…
#
# A Claude Pro/Max subscription cannot drive Prism, and the OAuth token the
# `claude` CLI stores will not work here: Anthropic bills tool calls made by
# anything other than Claude Code against extra usage rather than plan limits,
# so the agent loop fails on it. Prism says so at startup rather than letting it
# fail as an opaque 401. See the README.
#
# Chat model (overrides OLLAMA_MODEL when LLM_BACKEND=anthropic).
# ANTHROPIC_MODEL=claude-sonnet-5
#
# API root — only for a proxy or gateway; empty = https://api.anthropic.com
# ANTHROPIC_BASE_URL=
#
# Anthropic serves no embeddings, so RAG stays on Ollama automatically — you do
# not need to set EMBED_BACKEND for it.

# EMBED_BACKEND decouples RAG embeddings from the chat backend.
# Empty = follow LLM_BACKEND. Set "ollama" to keep RAG on Ollama (OLLAMA_URL +
# EMBED_MODEL) when chat runs a chat-only server with no /v1/embeddings — e.g.
# Qwen3.5-122B + DFlash on a DGX Spark.
# EMBED_BACKEND=ollama
#
# Widget vision: the agent can look at a rendered widget to fix it. Set CHAT_VISION=false
# if the chat model is text-only (e.g. MiniMax) — the preview is captioned to text
# instead of shown. VISION_MODEL overrides the model used for that captioning.
# CHAT_VISION=false
# VISION_MODEL=

# PostgreSQL connection string — default works with the bundled postgres service
POSTGRES_URL=postgres://rag:rag@postgres:5432/rag?sslmode=disable

# SearXNG instance for web search (optional — remove to disable web search)
SEARXNG_URL=http://searxng:8080

# Access token — protects the dashboard with a login screen (optional, remove to disable auth)
# PRISM_TOKEN=change-me

# Multi-user mode: "1" turns Prism into a shared deployment — accounts, a signup/login
# page, groups, rooms, per-user scoping and an admin console. Unset (default) = personal,
# single-user, and PRISM_TOKEN is the whole of authentication.
# ⚠️ One-way door: turning this on migrates this deployment's config keys and secrets
# into the first admin's scope, and single-user mode would no longer find them.
# MULTI_USER=1

# Telephony: point VOX_URL at a PrismConnect instance (https://github.com/blazux/PrismConnect)
# and the agent gains a phone — it answers calls and can place/list/cancel them as tools.
# Empty = no telephony. VOX_USER/VOX_PASSWORD only if the PrismConnect UI is protected.
# VOX_URL=http://prismconnect:7860
# VOX_USER=
# VOX_PASSWORD=

# Timezone for the agent and cron jobs (IANA format, e.g. America/New_York, Europe/Paris)
TZ=UTC

# Workspace image variant:
#   unset (default) → ubuntu:22.04 base, ~2GB, no GPU preinstalled
#   gpu             → nvcr.io/nvidia/pytorch base, ~20GB, PyTorch+CUDA preinstalled for all architectures (Blackwell included)
# WORKSPACE=gpu

# Internal Docker settings — no need to change these
AGENT_CONTAINER=prism-workspace
WORKSPACE_DIR=/workspace
PLUGIN_DIR=/workspace/.plugins

# Host port range for Docker services started by the agent (docker_run tool)
# Each service gets the next available port in this range
SERVICE_PORT_START=20000
SERVICE_PORT_END=20999
