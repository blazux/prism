# URL of your Ollama instance — host-gateway resolves to your host machine from inside Docker
OLLAMA_URL=http://host-gateway:11434

# LLM model to use — must be pulled in Ollama first (ollama pull <model>)
OLLAMA_MODEL=qwen3.6:27b

# Embedding model for RAG — must be pulled in Ollama first
EMBED_MODEL=qwen3-embedding:8b

# LLM backend: "ollama" (default) or "openai" for any OpenAI-compatible server
# (SGLang, vLLM, TGI, LM Studio, llama.cpp, OpenAI, OpenRouter…). By default the
# "openai" backend serves chat, embeddings AND RAG vision captioning; use
# EMBED_BACKEND below to split them.
# LLM_BACKEND=openai
#
# Base URL pointing at the OpenAI /v1 root (used only when LLM_BACKEND=openai).
# For a local SGLang server: python -m sglang.launch_server --model ... --port 30000
# OPENAI_BASE_URL=http://host-gateway:30000/v1
#
# Bearer token for the openai backend — optional, local SGLang/vLLM need none.
# OPENAI_API_KEY=
#
# Chat model name for the openai backend (overrides OLLAMA_MODEL). Must match the
# server's --served-model-name.
# OPENAI_MODEL=
#
# EMBED_BACKEND decouples RAG embeddings + vision captioning from the chat backend.
# Empty = follow LLM_BACKEND. Set "ollama" to keep RAG on Ollama (OLLAMA_URL +
# EMBED_MODEL) when chat runs a chat-only server with no /v1/embeddings — e.g.
# Qwen3.5-122B + DFlash on a DGX Spark.
# EMBED_BACKEND=ollama
#
# Model for RAG image captioning. Defaults to the chat model; override when
# captioning runs on Ollama but the chat model name isn't an Ollama tag.
# VISION_MODEL=gemma4:e4b

# PostgreSQL connection string — default works with the bundled postgres service
POSTGRES_URL=postgres://rag:rag@postgres:5432/rag?sslmode=disable

# SearXNG instance for web search (optional — remove to disable web search)
SEARXNG_URL=http://searxng:8080

# Access token — protects the dashboard with a login screen (optional, remove to disable auth)
# PRISM_TOKEN=change-me

# Timezone for the agent and cron jobs (IANA format, e.g. America/New_York, Europe/Paris)
TZ=UTC

# Workspace image variant:
#   unset (default) → ubuntu:22.04 base, ~2GB, no GPU preinstalled
#   gpu             → nvcr.io/nvidia/pytorch base, ~20GB, PyTorch+CUDA preinstalled for all architectures (Blackwell included)
# WORKSPACE=gpu

# Internal Docker settings — no need to change these
AGENT_CONTAINER=prism-workspace
WORKSPACE_DIR=/workspace
PLUGIN_DIR=/workspace/.plugins

# Host port range for Docker services started by the agent (docker_run tool)
# Each service gets the next available port in this range
SERVICE_PORT_START=20000
SERVICE_PORT_END=20999
