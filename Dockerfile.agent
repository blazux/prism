FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=Etc/GMT+4
ENV PIP_CONSTRAINT=/etc/prism/python-constraints.txt

COPY workspace-security-constraints.txt /etc/prism/python-constraints.txt

RUN apt-get update && apt-get install -y \
    tzdata \
    python3 python3-pip python3-venv python3-dev \
    nodejs npm \
    golang-go \
    rustc cargo \
    curl wget git vim nano libbrotli1 \
    build-essential make \
    jq \
    sqlite3 \
    ffmpeg \
    imagemagick \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Common Python packages for data science / web
RUN pip3 install --no-cache-dir \
    requests httpx "Brotli>=1.2.1" \
    numpy pandas \
    matplotlib seaborn plotly \
    flask fastapi uvicorn \
    jupyter nbformat \
    pytest black ruff

# Playwright for browser automation (browser_exec / browser_act tools)
RUN pip3 install --no-cache-dir "playwright>=1.64.1" && \
    python3 -m playwright install chromium && \
    python3 -m playwright install-deps chromium && \
    mkdir -p /workspace/.screenshots

COPY scripts/check-workspace-security.py /usr/local/bin/check-workspace-security.py
RUN python3 /usr/local/bin/check-workspace-security.py

# Widget data lives at /workspace/data, served verbatim to the browser at /data/
# — the classic public/static-folder pattern, same name on both sides so there is
# nothing to translate. Two compatibility symlinks guard against the two ways a
# script can still miss: writing to the literal URL /data/<name>.json (mistaking
# the browser-facing prefix for a container path) instead of the relative
# data/<name>.json, and any old script still targeting the pre-rename
# widget_data/ directory name.
RUN ln -s /workspace/data /data
RUN ln -s data /workspace/widget_data

WORKDIR /workspace

# Restore persisted crontab (survives container recreation) then start cron
CMD ["sh", "-c", "[ -f /workspace/.apt-packages ] && apt-get update -qq && xargs apt-get install -y < /workspace/.apt-packages; [ -f /workspace/.pip-packages ] && pip3 install -q $(cat /workspace/.pip-packages); [ -f /workspace/.crontab ] && crontab /workspace/.crontab; cron && tail -f /dev/null"]
