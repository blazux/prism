FROM node:26-bookworm-slim AS node-runtime

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=Etc/GMT+4

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
COPY --from=node-runtime /usr/local/include/node/ /usr/local/include/node/
COPY workspace-security-constraints.txt /etc/prism/python-constraints.txt
COPY scripts/configure-workspace-pip.py /usr/local/bin/configure-workspace-pip.py

RUN apt-get update && apt-get install -y \
    tzdata \
    python3 python3-pip python3-venv python3-dev python-is-python3 \
    golang-go \
    rustc cargo \
    curl wget git vim nano libbrotli1 \
    build-essential make \
    jq \
    sqlite3 \
    ffmpeg \
    imagemagick \
    cron \
    && rm -rf /var/lib/apt/lists/*

RUN python3 /usr/local/bin/configure-workspace-pip.py
ENV PIP_CONSTRAINT=/etc/prism/python-constraints.txt

# Common Python packages for data science / web
RUN pip3 install --no-cache-dir \
    requests httpx Brotli Pillow SoupSieve \
    numpy pandas \
    matplotlib seaborn plotly \
    flask fastapi uvicorn \
    jupyter nbformat \
    pytest black ruff

# Playwright for browser automation (browser_exec / browser_act tools)
RUN pip3 install --no-cache-dir "playwright>=1.64.1" && \
    python3 -m playwright install chromium && \
    python3 -m playwright install-deps chromium && \
    mkdir -p /workspace/.screenshots

# Cron uses /usr/bin:/bin instead of the container's PATH.
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js install --global --prefix /usr/local --no-audit --no-fund npm@12.2.3 && \
    node /usr/local/lib/node_modules/npm/bin/npm-cli.js cache clean --force && \
    ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    for binary in node npm npx; do ln -sf "/usr/local/bin/$binary" "/usr/bin/$binary"; done && \
    ln -sf /usr/local/bin/node /usr/bin/nodejs

COPY scripts/check-workspace-security.py /usr/local/bin/check-workspace-security.py
RUN python3 /usr/local/bin/check-workspace-security.py

# Widget data lives at /workspace/data, served verbatim to the browser at /data/
# — the classic public/static-folder pattern, same name on both sides so there is
# nothing to translate. Two compatibility symlinks guard against the two ways a
# script can still miss: writing to the literal URL /data/<name>.json (mistaking
# the browser-facing prefix for a container path) instead of the relative
# data/<name>.json, and any old script still targeting the pre-rename
# widget_data/ directory name.
RUN ln -s /workspace/data /data
RUN ln -s data /workspace/widget_data

WORKDIR /workspace

COPY --chmod=755 scripts/workspace-start.sh /usr/local/bin/prism-workspace-start
CMD ["/usr/local/bin/prism-workspace-start", "python3"]
