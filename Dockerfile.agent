FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TZ=Etc/GMT+4

RUN apt-get update && apt-get install -y \
    tzdata \
    python3 python3-pip python3-venv python3-dev \
    nodejs npm \
    golang-go \
    rustc cargo \
    curl wget git vim nano \
    build-essential make \
    jq \
    sqlite3 \
    ffmpeg \
    imagemagick \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Common Python packages for data science / web
RUN pip3 install --no-cache-dir \
    requests httpx \
    numpy pandas \
    matplotlib seaborn plotly \
    flask fastapi uvicorn \
    jupyter nbformat \
    pytest black ruff

# Playwright for browser automation (browser_exec / browser_act tools)
RUN pip3 install --no-cache-dir playwright && \
    python3 -m playwright install chromium && \
    python3 -m playwright install-deps chromium && \
    mkdir -p /workspace/.screenshots

# /data is a compatibility symlink to /workspace/widget_data — the agent writes
# widget polling files under /workspace/widget_data/, and prism-server serves them
# to the browser at the URL /data/<name>.json. Two different names for the same
# thing invited exactly the bug this fixes: an agent script that wrote to a literal
# /data/<name>.json (mistaking the browser-facing URL prefix for a container path)
# silently created an unrelated file at the container root instead of erroring —
# the write looked like it worked, but the browser never saw it. With the symlink,
# writing to either path lands in the same real file.
RUN ln -s /workspace/widget_data /data

WORKDIR /workspace

# Restore persisted crontab (survives container recreation) then start cron
CMD ["sh", "-c", "[ -f /workspace/.apt-packages ] && apt-get update -qq && xargs apt-get install -y < /workspace/.apt-packages; [ -f /workspace/.pip-packages ] && pip3 install -q $(cat /workspace/.pip-packages); [ -f /workspace/.crontab ] && crontab /workspace/.crontab; cron && tail -f /dev/null"]
