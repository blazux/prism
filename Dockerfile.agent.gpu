FROM node:26-bookworm-slim AS node-runtime

FROM nvcr.io/nvidia/pytorch:26.03-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
COPY --from=node-runtime /usr/local/include/node/ /usr/local/include/node/
COPY workspace-security-constraints.txt /etc/prism/python-constraints.txt
COPY scripts/configure-workspace-pip.py /usr/local/bin/configure-workspace-pip.py
# Preserve NVIDIA's native APIs and their dependency compatibility, including
# releases whose upstream constraint file is empty.
RUN PRISM_PRESERVE_PYTHON_PACKAGES="torch torchvision numpy pyarrow huggingface-hub click" \
    python /usr/local/bin/configure-workspace-pip.py
ENV PIP_CONSTRAINT=/etc/prism/python-constraints.txt

# Tools not included in the NVIDIA base
RUN apt-get update && apt-get install -y \
    apt apt-utils \
    golang-go \
    rustc cargo \
    vim nano libbrotli1 \
    jq \
    sqlite3 \
    ffmpeg \
    imagemagick \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Extra Python packages (PyTorch, numpy, CUDA already in base)
RUN pip install --no-cache-dir \
    httpx Brotli Pillow SoupSieve \
    aiohttp anyio filelock fsspec datasets jupyter-server jupyterlab mistune msgpack \
    nbconvert notebook onnx tornado urllib3 uv \
    pandas \
    matplotlib seaborn plotly \
    flask fastapi uvicorn \
    jupyter nbformat \
    pytest black ruff

# Playwright for browser automation
RUN pip install --no-cache-dir "playwright>=1.64.1" && \
    python -m playwright install chromium && \
    python -m playwright install-deps chromium && \
    mkdir -p /workspace/.screenshots

# Keep the maintained runtime available to existing cron commands too.
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js install --global --prefix /usr/local --no-audit --no-fund npm@12.2.3 && \
    node /usr/local/lib/node_modules/npm/bin/npm-cli.js cache clean --force && \
    ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    for binary in node npm npx; do ln -sf "/usr/local/bin/$binary" "/usr/bin/$binary"; done && \
    ln -sf /usr/local/bin/node /usr/bin/nodejs

COPY scripts/check-workspace-security.py /usr/local/bin/check-workspace-security.py
RUN python /usr/local/bin/check-workspace-security.py

# Widget data lives at /workspace/data, served verbatim to the browser at /data/ —
# see Dockerfile.agent for the rationale. Two compatibility symlinks: the literal
# URL-shaped path some scripts still write to, and the pre-rename directory name.
RUN ln -s /workspace/data /data
RUN ln -s data /workspace/widget_data

WORKDIR /workspace

COPY --chmod=755 scripts/workspace-start.sh /usr/local/bin/prism-workspace-start
CMD ["/usr/local/bin/prism-workspace-start", "python"]
