FROM nvcr.io/nvidia/pytorch:26.03-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY workspace-security-constraints.txt /etc/prism/python-constraints.txt
# Retain the NVIDIA image's Python/CUDA constraints alongside the security floor.
RUN for constraints in ${PIP_CONSTRAINT:-}; do \
        if [ "$constraints" != /etc/prism/python-constraints.txt ]; then \
            printf '\n-c %s\n' "$constraints" >> /etc/prism/python-constraints.txt; \
        fi; \
    done
ENV PIP_CONSTRAINT=/etc/prism/python-constraints.txt

# Tools not included in the NVIDIA base
RUN apt-get update && apt-get install -y \
    nodejs npm \
    golang-go \
    rustc cargo \
    vim nano libbrotli1 \
    jq \
    sqlite3 \
    ffmpeg \
    imagemagick \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Extra Python packages (PyTorch, numpy, CUDA already in base)
RUN pip install --no-cache-dir \
    httpx "Brotli>=1.2.1" \
    pandas \
    matplotlib seaborn plotly \
    flask fastapi uvicorn \
    jupyter nbformat \
    pytest black ruff

# Playwright for browser automation
RUN pip install --no-cache-dir "playwright>=1.64.1" && \
    python -m playwright install chromium && \
    python -m playwright install-deps chromium && \
    mkdir -p /workspace/.screenshots

COPY scripts/check-workspace-security.py /usr/local/bin/check-workspace-security.py
RUN python /usr/local/bin/check-workspace-security.py

# Widget data lives at /workspace/data, served verbatim to the browser at /data/ —
# see Dockerfile.agent for the rationale. Two compatibility symlinks: the literal
# URL-shaped path some scripts still write to, and the pre-rename directory name.
RUN ln -s /workspace/data /data
RUN ln -s data /workspace/widget_data

WORKDIR /workspace

CMD ["sh", "-c", "[ -f /workspace/.apt-packages ] && apt-get update -qq && xargs apt-get install -y < /workspace/.apt-packages; [ -f /workspace/.pip-packages ] && pip install -q $(cat /workspace/.pip-packages); [ -f /workspace/.crontab ] && crontab /workspace/.crontab; cron && tail -f /dev/null"]
