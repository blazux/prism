#!/bin/sh
set -eu
config=/etc/nftables.d/vps-firewall.nft
if [ "${1:-}" = "--check" ]; then
    check=-c
elif [ "$#" -eq 0 ]; then
    check=
else
    echo "Usage: vps-firewall [--check]" >&2
    exit 2
fi
# Replace only our own table in one transaction; never flush Docker's rules.
{
    if /usr/sbin/nft list table inet vps_firewall >/dev/null 2>&1; then
        echo 'delete table inet vps_firewall'
    fi
    cat "$config"
} | /usr/sbin/nft $check -f -
