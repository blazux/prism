[Unit]
Description=VPS inbound firewall
Wants=network-pre.target
Before=network-pre.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/vps-firewall
ExecReload=/usr/local/sbin/vps-firewall
ExecStop=-/usr/sbin/nft delete table inet vps_firewall

[Install]
WantedBy=multi-user.target
