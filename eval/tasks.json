  {
    "name": "docker-run-and-embed",
    "tags": [
      "docker",
      "slow"
    ],
    "prompt": "Start an nginx container named eval-nginx (image nginx:alpine, port 80) and add a dashboard widget titled 'Eval Nginx' that embeds it.",
    "checks": [
      {
        "tool": "docker_manage",
        "args": {
          "action": "ps"
        },
        "contains": "eval-nginx",
        "no_error": true
      },
      {
        "tool": "widget",
        "args": {
          "action": "list"
        },
        "contains": "Eval Nginx",
        "no_error": true
      }
    ],
    "max_tool_calls": 5,
    "timeout_sec": 900,
    "cleanup": [
      {
        "tool": "widget",
        "args": {
          "action": "remove",
          "id": "eval-nginx"
        }
      },
      {
        "tool": "docker_manage",
        "args": {
          "action": "stop",
          "name": "eval-nginx"
        }
      }
    ]
