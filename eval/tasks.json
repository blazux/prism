  {
    "name": "cron-remove",
    "tags": [
      "cron"
    ],
    "prompt": "Remove the scheduled job called eval-stale.",
    "setup": [
      {
        "tool": "cron",
        "args": {
          "action": "add",
          "name": "eval-stale",
          "schedule": "*/30 * * * *",
          "command": "echo stale",
          "description": "eval fixture"
        }
      }
    ],
    "checks": [
      {
        "tool": "cron",
        "args": {
          "action": "list"
        },
        "not_contains": "eval-stale",
        "no_error": true
      }
    ],
    "max_tool_calls": 3
  },
