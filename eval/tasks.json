          "id": "eval-clock"
        }
      }
    ]
  },
  {
    "name": "widget-polling-file",
    "tags": [
      "widgets",
      "pattern"
    ],
    "prompt": "Write a JSON file data/eval-status.json containing {\"status\":\"green\",\"count\":42}. Then add a dashboard widget titled 'Eval Status' that fetches that file every 10 seconds and displays the status and the count.",
    "checks": [
