    "checks": [
      {
        "tool": "widget",
        "args": {
          "action": "list"
        },
        "contains": "Eval Counter v2",
        "no_error": true
      }
    ],
    "max_tool_calls": 3,
    "cleanup": [
      {
        "tool": "widget",
        "args": {
          "action": "remove",
          "id": "eval-counter"
        }
      }
    ]
  },
  {
    "name": "custom-tool-register-and-use",
    "tags": [
      "tools",
      "core"
    ],
    "prompt": "Create a custom tool named eval_double that takes an integer argument n and returns n*2 as JSON. Then use it to compute the double of 21 and tell me the result.",
    "checks": [
      {
        "tool": "list_tools",
        "contains": "eval_double",
        "no_error": true
      },
      {
        "tool": "eval_double",
        "args": {
          "n": 5
        },
        "contains": "10",
        "no_error": true
      },
      {
        "response": true,
        "contains": "42"
      }
    ],
    "max_tool_calls": 5,
    "cleanup": [
      {
        "tool": "exec_command",
        "args": {
          "command": "rm -f agent_tools/eval_double.py"
        }
      }
    ]
  },
  {
    "name": "cron-add-and-list",
    "tags": [
      "cron",
      "core"
    ],
