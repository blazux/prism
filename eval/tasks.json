      },
      {
        "tool": "widget",
        "args": {
          "action": "list"
        },
        "contains": "Eval Status",
        "no_error": true
      }
    ],
    "max_tool_calls": 5,
    "cleanup": [
      {
        "tool": "widget",
        "args": {
          "action": "remove",
          "id": "eval-status"
        }
      },
      {
        "tool": "delete_file",
        "args": {
          "path": "data/eval-status.json"
        }
      }
    ]
  },
  {
    "name": "widget-update-existing",
    "tags": [
      "widgets"
    ],
    "prompt": "There is a widget called 'Eval Counter' on the dashboard. Change its title to 'Eval Counter v2' without recreating it.",
    "setup": [
      {
        "tool": "widget",
        "args": {
          "action": "add",
          "id": "eval-counter",
          "title": "Eval Counter",
          "content": "<div style=\"padding:12px\">count: 1</div>"
