[
  {
    "name": "file-write-read",
    "tags": [
      "files",
      "core"
    ],
    "prompt": "Create a file eval/hello.txt whose content is exactly the line: hello from prism eval",
    "checks": [
      {
        "tool": "read_file",
        "args": {
          "path": "eval/hello.txt"
        },
        "contains": "hello from prism eval",
        "no_error": true
      }
    ],
    "max_tool_calls": 3,
    "cleanup": [
      {
        "tool": "exec_command",
        "args": {
          "command": "rm -rf eval"
        }
      }
    ]
  },
  {
    "name": "file-list-count",
    "tags": [
      "files",
      "core"
    ],
    "prompt": "Create a directory eval/tree containing three empty files named a.txt, b.txt and c.txt, then tell me how many files it contains.",
    "checks": [
      {
        "tool": "list_files",
        "args": {
          "path": "eval/tree"
        },
        "contains_all": [
          "a.txt",
          "b.txt",
          "c.txt"
        ],
        "no_error": true
      },
      {
        "response": true,
        "regex": "\\b(3|three)\\b"
      }
    ],
    "max_tool_calls": 4,
    "cleanup": [
      {
        "tool": "exec_command",
        "args": {
          "command": "rm -rf eval"
        }
      }
    ]
  },
  {
    "name": "exec-python-compute",
    "tags": [
      "exec",
      "core"
    ],
    "prompt": "Using Python in the workspace, compute the 20th Fibonacci number (F(1)=F(2)=1) and write just the number to eval/fib.txt. Then tell me the number.",
    "checks": [
      {
        "tool": "read_file",
        "args": {
          "path": "eval/fib.txt"
        },
        "contains": "6765",
        "no_error": true
      },
      {
        "response": true,
        "contains": "6765"
      }
    ],
    "max_tool_calls": 4,
    "cleanup": [
      {
        "tool": "exec_command",
        "args": {
          "command": "rm -rf eval"
        }
      }
    ]
  },
  {
    "name": "exec-fix-broken-script",
    "tags": [
      "exec",
      "recovery"
    ],
    "prompt": "The script eval/broken.py should print the sum of the integers from 1 to 10 inclusive, but it is broken. Run it, fix the bug in place, run it again and tell me what it prints.",
    "setup": [
      {
        "tool": "write_file",
        "args": {
          "path": "eval/broken.py",
          "content": "total = 0\nfor i in range(1, 10)\n    total += i\nprint(total)\n"
        }
      }
    ],
    "checks": [
      {
        "tool": "exec_command",
        "args": {
          "command": "python3 eval/broken.py"
        },
        "regex": "^\\s*55\\s*$",
        "no_error": true
      },
      {
        "response": true,
        "contains": "55"
      }
    ],
    "max_tool_calls": 6,
    "cleanup": [
      {
        "tool": "exec_command",
        "args": {
          "command": "rm -rf eval"
        }
      }
    ]
  },
  {
    "name": "exec-large-output",
    "tags": [
      "exec",
      "context"
    ],
    "prompt": "Run a command that prints the numbers 1 to 20000, one per line, then tell me the last number printed. Do not write any file.",
    "checks": [
      {
        "response": true,
        "contains": "20000"
      }
    ],
    "max_tool_calls": 3
  },
  {
    "name": "widget-static",
